# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/cp_room_booking
DB_USERNAME=postgres
DB_PASSWORD=change-me
JPA_DDL_AUTO=update

# Firebase Admin SDK service account (server only).
# FIREBASE_PROJECT_ID must match NEXT_PUBLIC_FIREBASE_PROJECT_ID in the frontend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key from the service-account JSON, with \n between lines.
FIREBASE_PRIVATE_KEY=

# Comma-separated Google account email addresses allowed to manage the app
ADMIN_EMAILS=

# Exact frontend origins allowed to call this API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
